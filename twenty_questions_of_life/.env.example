# Copy this file to .env and fill in the key. setup.ps1 does that for you.
# .env is gitignored - do not commit it, and keep it out of anything that syncs.

# Required. The panel, the marking and the write-up all run through this.
OPENAI_API_KEY=sk-...

# Optional. Any model LiteLLM understands. Left unset, crewAI uses gpt-4o-mini.
# A full 20-question run is roughly 140 model calls, so this is the setting
# that decides what an interview costs you.
#   gpt-4o-mini   cheap, and honestly good enough for this
#   gpt-4o        sharper questions, several times the price
# MODEL=gpt-4o-mini

# Optional. The shared secret the web front end asks for when it is reachable
# from another device. Leave it unset and one is generated each time the server
# starts, which means the link changes on every restart. Set your own if you
# want a link that keeps working - treat it like a password.
# INTERVIEW_TOKEN=

# crewAI ships with OpenTelemetry switched on and reports to its own endpoint.
# When that endpoint is slow or blocked it buries the errors you care about
# under retry messages, so it is off here. Delete this line to send it.
OTEL_SDK_DISABLED=true
